{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "asNeeded"
    }
  },
  "plugins": ["./biome/unknown-not-absent.grit"],
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "suspicious": {
        "noExplicitAny": "error"
      },
      "style": {
        "noNonNullAssertion": "error"
      },
      "correctness": {
        "noUnusedImports": "error"
      }
    }
  },
  "files": {
    "includes": [
      "**",
      "!**/.claude-plugin/types",
      "!**/node_modules",
      "!**/test/fixtures/**/*.md",
      "!**/test/e2e/out"
    ]
  }
}
